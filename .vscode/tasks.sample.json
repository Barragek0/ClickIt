{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build and Test",
      "dependsOn": [
        "Build and Test: Build and run tests",
        "Build and Test: Verify formatting"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build and Test: Build and run tests",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tests/Scripts/invoke-build-and-test.ps1",
        "-SolutionPath",
        "${workspaceFolder}/ClickIt.sln",
        "-TestProjectPath",
        "${workspaceFolder}/Tests/ClickIt.Tests.csproj",
        "-Configuration",
        "Debug",
        "-PluginOutputPath",
        "${workspaceFolder}/artifacts/Plugins/Compiled/ClickIt",
        "-BuildTool",
        "dotnet",
        "-NoIncrementalBuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Build and Test: Verify formatting",
      "type": "process",
      "command": "dotnet",
      "args": [
        "format",
        "${workspaceFolder}/ClickIt.sln",
        "whitespace",
        "--verify-no-changes",
        "--verbosity",
        "quiet"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tests/Scripts/invoke-dotnet-test-with-memory-guard.ps1",
        "-ProjectPath",
        "${workspaceFolder}/Tests/ClickIt.Tests.csproj",
        "-Configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Review Coverage",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/Tests/Scripts/generate-coverage.ps1",
        "-Configuration",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    }
  ]
}
